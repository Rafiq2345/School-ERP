# ==========================================
# School-ERP: Environment Variable Template
# ==========================================
# Copy this file to .env.local (development) or .env.production (production).
# NEVER commit real credentials, passwords, or secrets to version control.

# Application Environment
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_erp_dev?schema=public"

# Security & Authentication Secrets (Generate with `openssl rand -base64 32`)
SESSION_SECRET="replace-with-a-secure-random-32-byte-secret"
CSRF_SECRET="replace-with-a-secure-random-32-byte-secret"
JWT_SIGNING_KEY="replace-with-a-secure-random-32-byte-secret"

# MFA / TOTP Configuration
MFA_ISSUER_NAME="School-ERP"

# Storage Settings
STORAGE_LOCAL_PATH="./storage"
MAX_UPLOAD_SIZE_MB=10

# Localization & Default Locale (en = English, ur = Urdu)
DEFAULT_LOCALE="en"
AVAILABLE_LOCALES="en,ur"

# Logging Level (error, warn, info, http, debug)
LOG_LEVEL="info"
