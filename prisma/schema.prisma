  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  shiftId          String    @map("shift_id")
  assignmentType   String    @default("EMPLOYEE") @map("assignment_type") // EMPLOYEE, DEPARTMENT, DESIGNATION, INSTITUTIONAL_DEFAULT
  employeeId       String?   @map("employee_id")
  departmentId     String?   @map("department_id")
  designationId    String?   @map("designation_id")
  isOverride       Boolean   @default(false) @map("is_override") // true for individual employee custom overrides
  applicableDays   Json?     @map("applicable_days") // [1,2,3,4,5] or null to inherit from shift
  isActive         Boolean   @default(true) @map("is_active")
  effectiveFrom    DateTime  @map("effective_from") // Normalized UTC midnight
  effectiveTo      DateTime? @map("effective_to") // Normalized UTC midnight
  reason           String?
  assignedByUserId String?   @map("assigned_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shift       Shift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  employee    Employee?    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department  Department?  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  designation Designation? @relation(fields: [designationId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId, effectiveFrom])
  @@index([tenantId, departmentId, effectiveFrom])
  @@index([tenantId, designationId, effectiveFrom])
  @@index([tenantId, assignmentType])
  @@index([tenantId, isActive])
  @@map("employee_shift_assignments")
}

