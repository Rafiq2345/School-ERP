  tenant            Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rules             LeaveApprovalWorkflowRule[]
  steps             LeaveApprovalWorkflowStep[]
  approvalInstances LeaveRequestApprovalInstance[]

  @@unique([tenantId, code])
