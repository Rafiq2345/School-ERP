  label                   String
  value                   String
  sortOrder               Int      @default(0) @map("sort_order")
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customFieldDefinition CustomFieldDefinition @relation(fields: [customFieldDefinitionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, customFieldDefinitionId, value])
  @@map("custom_field_options")
}

// ---------------------------------------------------------
// 8.1 STUDENT MANAGEMENT (STUDENTS, GUARDIANS, ENROLLMENTS & LIFECYCLE)
// ---------------------------------------------------------

model Student {
  id                    String   @id @default(uuid())
  tenantId              String   @map("tenant_id")
  admissionNo           String   @map("admission_no")
  registrationNo        String?  @map("registration_no")
  firstNameEn           String   @map("first_name_en")
  lastNameEn            String?  @map("last_name_en")
  fullNameUr            String?  @map("full_name_ur")
  gender                String   @default("MALE") // MALE, FEMALE, OTHER
  dob                   DateTime @map("dob")
  bloodGroup            String   @default("UNKNOWN") @map("blood_group") // A_POS, A_NEG, B_POS, B_NEG, O_POS, O_NEG, AB_POS, AB_NEG, UNKNOWN
  religion              String?  @default("ISLAM")
  nationality           String?  @default("PAKISTANI")
  nationalId            String?  @map("national_id") // B-Form / CNIC / Passport No
  photoUrl              String?  @map("photo_url")
  admissionDate         DateTime @default(now()) @map("admission_date")
  admissionSessionId    String   @map("admission_session_id")
  categoryId            String?  @map("category_id")
  houseId               String?  @map("house_id")
  primaryContactPhone   String?  @map("primary_contact_phone")
  emergencyContactName  String?  @map("emergency_contact_name")
  emergencyContactPhone String?  @map("emergency_contact_phone")
  currentAddressEn      String?  @map("current_address_en")
  currentAddressUr      String?  @map("current_address_ur")
  permanentAddressEn    String?  @map("permanent_address_en")
  city                  String?  @default("Karachi")
  currentStatus         String   @default("ACTIVE") @map("current_status") // ACTIVE, INACTIVE, WITHDRAWN, TRANSFERRED, GRADUATED, LEFT, SUSPENDED
  customFieldValues     Json?    @map("custom_field_values")
  notes                 String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  tenant                   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  admissionSession         AcademicSession           @relation("AdmissionSession", fields: [admissionSessionId], references: [id], onDelete: Restrict)
  category                 StudentCategory?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  house                    House?                    @relation(fields: [houseId], references: [id], onDelete: SetNull)
  guardians                StudentGuardianRelation[]
  enrollments              StudentEnrollment[]
  statusHistories          StudentStatusHistory[]
  documents                StudentDocument[]
  previousSchools          StudentPreviousSchool[]
  promotionBatchItems      PromotionBatchItem[]
  studentAttendanceRecords StudentAttendanceRecord[]
  attendanceAuditLogs      AttendanceAuditLog[]

  @@unique([tenantId, admissionNo])
  @@index([tenantId, currentStatus])
  @@index([tenantId, categoryId])
  @@index([tenantId, houseId])
  @@index([tenantId, admissionSessionId])
  @@map("students")
}

model Guardian {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  userId             String?  @map("user_id") // Optional link to User for Parent Portal
  fullNameEn         String   @map("full_name_en")
  fullNameUr         String?  @map("full_name_ur")
  nationalId         String?  @map("national_id") // CNIC / Passport No
  relationshipType   String   @default("FATHER") @map("relationship_type") // FATHER, MOTHER, GUARDIAN
  occupation         String?
  employer           String?
  designation        String?
  annualIncome       Decimal? @map("annual_income") @db.Decimal(12, 2)
  primaryPhone       String   @map("primary_phone")
  secondaryPhone     String?  @map("secondary_phone")
  email              String?
  residentialAddress String?  @map("residential_address")
  officeAddress      String?  @map("office_address")
  city               String?  @default("Karachi")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  students StudentGuardianRelation[]

  @@index([tenantId, nationalId])
  @@index([tenantId, primaryPhone])
  @@map("guardians")
}

model StudentGuardianRelation {
  id                     String   @id @default(uuid())
  tenantId               String   @map("tenant_id")
  studentId              String   @map("student_id")
  guardianId             String   @map("guardian_id")
  relationship           String   @default("FATHER") // FATHER, MOTHER, GUARDIAN, STEP_FATHER, STEP_MOTHER, OTHER
  isPrimaryContact       Boolean  @default(true) @map("is_primary_contact")
  isEmergencyContact     Boolean  @default(false) @map("is_emergency_contact")
  isFinancialResponsible Boolean  @default(true) @map("is_financial_responsible")
  hasPortalAccess        Boolean  @default(true) @map("has_portal_access")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentId, guardianId])
  @@map("student_guardian_relations")
}

model StudentEnrollment {
  id                       String   @id @default(uuid())
  tenantId                 String   @map("tenant_id")
  studentId                String   @map("student_id")
  academicSessionId        String   @map("academic_session_id")
  classId                  String   @map("class_id")
  sectionId                String   @map("section_id")
  rollNumber               String?  @map("roll_number")
  enrollmentDate           DateTime @default(now()) @map("enrollment_date")
  enrollmentType           String   @default("NEW_ADMISSION") @map("enrollment_type") // NEW_ADMISSION, PROMOTION, REPEAT, TRANSFER_IN, READMISSION
  status                   String   @default("ACTIVE") // ACTIVE, COMPLETED, PROMOTED, WITHDRAWN, REPEATED, TRANSFERRED
  isCurrent                Boolean  @default(true) @map("is_current")
  promotedFromEnrollmentId String?  @map("promoted_from_enrollment_id")
  notes                    String?
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student           Student                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicSession   AcademicSession           @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  schoolClass       SchoolClass               @relation(fields: [classId], references: [id], onDelete: Restrict)
  section           Section                   @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  promotedFrom      StudentEnrollment?        @relation("EnrollmentProgression", fields: [promotedFromEnrollmentId], references: [id], onDelete: SetNull)
  promotedTo        StudentEnrollment[]       @relation("EnrollmentProgression")
  attendanceRecords StudentAttendanceRecord[]

  @@unique([tenantId, studentId, academicSessionId])
  @@index([tenantId, classId, sectionId])
  @@index([tenantId, isCurrent])
  @@map("student_enrollments")
}

model StudentStatusHistory {
  id                     String    @id @default(uuid())
  tenantId               String    @map("tenant_id")
  studentId              String    @map("student_id")
  previousStatus         String    @map("previous_status")
  newStatus              String    @map("new_status")
  reason                 String
  effectiveDate          DateTime  @default(now()) @map("effective_date")
  leavingCertificateNo   String?   @map("leaving_certificate_no")
  leavingCertificateDate DateTime? @map("leaving_certificate_date")
  remarks                String?
  changedByUserId        String?   @map("changed_by_user_id")
  createdAt              DateTime  @default(now()) @map("created_at")

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  changedBy User?   @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, studentId])
  @@map("student_status_history")
}

model StudentDocument {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  studentId        String    @map("student_id")
  documentType     String    @map("document_type") // B_FORM, BIRTH_CERTIFICATE, PREVIOUS_SLC, FATHER_CNIC, MOTHER_CNIC, VACCINATION_CARD, PHOTO, OTHER
  title            String
  documentUrl      String    @map("document_url")
  fileSize         Int?      @map("file_size")
  mimeType         String?   @map("mime_type")
  verifiedAt       DateTime? @map("verified_at")
  uploadedByUserId String?   @map("uploaded_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, studentId])
  @@map("student_documents")
}

model StudentPreviousSchool {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  studentId        String    @map("student_id")
  schoolName       String    @map("school_name")
  lastClassPassed  String    @map("last_class_passed")
  boardOrInstitute String?   @map("board_or_institute")
  slcNumber        String?   @map("slc_number")
  slcIssueDate     DateTime? @map("slc_issue_date")
  percentageOrGpa  Decimal?  @map("percentage_or_gpa") @db.Decimal(5, 2)
  remarks          String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId])
  @@map("student_previous_schools")
}

// ---------------------------------------------------------
// 12. STUDENT MANAGEMENT: BULK PROMOTION & GRADUATION BATCHES
// ---------------------------------------------------------

model PromotionBatch {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  batchNumber        String    @map("batch_number")
  sourceSessionId    String    @map("source_session_id")
  targetSessionId    String    @map("target_session_id")
  sourceClassId      String    @map("source_class_id")
  sourceSectionId    String?   @map("source_section_id")
  targetClassId      String?   @map("target_class_id")
  targetSectionId    String?   @map("target_section_id")
  isGraduation       Boolean   @default(false) @map("is_graduation")
  totalStudents      Int       @default(0) @map("total_students")
  promotedCount      Int       @default(0) @map("promoted_count")
  repeatedCount      Int       @default(0) @map("repeated_count")
  graduatedCount     Int       @default(0) @map("graduated_count")
  heldCount          Int       @default(0) @map("held_count")
  excludedCount      Int       @default(0) @map("excluded_count")
  isRolledBack       Boolean   @default(false) @map("is_rolled_back")
  rolledBackAt       DateTime? @map("rolled_back_at")
  rolledBackByUserId String?   @map("rolled_back_by_user_id")
  rollbackReason     String?   @map("rollback_reason")
  processedByUserId  String?   @map("processed_by_user_id")
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceSession AcademicSession      @relation("BatchSourceSession", fields: [sourceSessionId], references: [id], onDelete: Restrict)
  targetSession AcademicSession      @relation("BatchTargetSession", fields: [targetSessionId], references: [id], onDelete: Restrict)
  sourceClass   SchoolClass          @relation("BatchSourceClass", fields: [sourceClassId], references: [id], onDelete: Restrict)
  sourceSection Section?             @relation("BatchSourceSection", fields: [sourceSectionId], references: [id], onDelete: SetNull)
  targetClass   SchoolClass?         @relation("BatchTargetClass", fields: [targetClassId], references: [id], onDelete: SetNull)
  targetSection Section?             @relation("BatchTargetSection", fields: [targetSectionId], references: [id], onDelete: SetNull)
  processedBy   User?                @relation("BatchProcessor", fields: [processedByUserId], references: [id], onDelete: SetNull)
  rolledBackBy  User?                @relation("BatchRollbacker", fields: [rolledBackByUserId], references: [id], onDelete: SetNull)
  items         PromotionBatchItem[]

  @@unique([tenantId, batchNumber])
  @@index([tenantId, sourceSessionId])
  @@index([tenantId, targetSessionId])
  @@map("promotion_batches")
}

model PromotionBatchItem {
  id                    String   @id @default(uuid())
  tenantId              String   @map("tenant_id")
  batchId               String   @map("batch_id")
  studentId             String   @map("student_id")
  decision              String // PROMOTE, REPEAT, GRADUATE, HOLD, EXCLUDE
  sourceEnrollmentId    String?  @map("source_enrollment_id")
  targetEnrollmentId    String?  @map("target_enrollment_id")
  previousStudentStatus String   @map("previous_student_status")
  newStudentStatus      String   @map("new_student_status")
  targetClassId         String?  @map("target_class_id")
  targetSectionId       String?  @map("target_section_id")
  remarks               String?
  createdAt             DateTime @default(now()) @map("created_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch   PromotionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, batchId])
  @@index([tenantId, studentId])
  @@map("promotion_batch_items")
}

// ---------------------------------------------------------
// 13. ATTENDANCE MANAGEMENT (PHASE 1: DAILY ROSTER & AUDIT)
// ---------------------------------------------------------

model StudentAttendanceRecord {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  studentId         String   @map("student_id")
  enrollmentId      String   @map("enrollment_id")
  academicSessionId String   @map("academic_session_id")
  classId           String   @map("class_id")
  sectionId         String   @map("section_id")
  attendanceDate    DateTime @map("attendance_date") // Normalized UTC midnight
  status            String   @default("PRESENT") // PRESENT, ABSENT, LATE, LEAVE, HALF_DAY, EXCUSED
  remarks           String?
  recordedByUserId  String?  @map("recorded_by_user_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student         Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment      StudentEnrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  academicSession AcademicSession      @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  schoolClass     SchoolClass          @relation(fields: [classId], references: [id], onDelete: Restrict)
  section         Section              @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  recordedBy      User?                @relation("AttendanceRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  auditLogs       AttendanceAuditLog[]

  @@unique([tenantId, studentId, attendanceDate])
  @@index([tenantId, attendanceDate])
  @@index([tenantId, classId, sectionId, attendanceDate])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
  @@map("student_attendance_records")
}

model AttendanceAuditLog {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  attendanceRecordId String   @map("attendance_record_id")
  studentId          String   @map("student_id")
  attendanceDate     DateTime @map("attendance_date")
  previousStatus     String   @map("previous_status")
  newStatus          String   @map("new_status")
  previousRemarks    String?  @map("previous_remarks")
  newRemarks         String?  @map("new_remarks")
  correctionReason   String   @map("correction_reason")
  correctedByUserId  String?  @map("corrected_by_user_id")
  createdAt          DateTime @default(now()) @map("created_at")

  tenant           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attendanceRecord StudentAttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  student          Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  correctedBy      User?                   @relation("AttendanceCorrector", fields: [correctedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, attendanceRecordId])
  @@index([tenantId, studentId])
  @@map("attendance_audit_logs")
}

// ---------------------------------------------------------
// 14. CENTRAL SCHOOL CALENDAR & HOLIDAY MANAGEMENT
// ---------------------------------------------------------

model SchoolHoliday {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  title              String
  holidayType        String    @default("PUBLIC_HOLIDAY") @map("holiday_type") // PUBLIC_HOLIDAY, NATIONAL_HOLIDAY, RELIGIOUS_HOLIDAY, VACATION, EMERGENCY_CLOSURE, WEEKLY_OFF, CUSTOM_NON_WORKING
  startDate          DateTime  @map("start_date") // Normalized UTC midnight
  endDate            DateTime  @map("end_date") // Normalized UTC midnight
  scope              String    @default("WHOLE_SCHOOL") // WHOLE_SCHOOL, ACADEMIC_SESSION, CLASS_SPECIFIC
  academicSessionId  String?   @map("academic_session_id")
  targetClassIds     String[]  @default([]) @map("target_class_ids") // For CLASS_SPECIFIC scope
  status             String    @default("ACTIVE") // ACTIVE, CANCELLED
  description        String?
  cancellationReason String?   @map("cancellation_reason")
  cancelledAt        DateTime? @map("cancelled_at")
  cancelledByUserId  String?   @map("cancelled_by_user_id")
  createdByUserId    String?   @map("created_by_user_id")
  updatedByUserId    String?   @map("updated_by_user_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicSession AcademicSession?  @relation(fields: [academicSessionId], references: [id], onDelete: SetNull)
  createdBy       User?             @relation("HolidayCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  cancelledBy     User?             @relation("HolidayCanceller", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  auditLogs       HolidayAuditLog[]

  @@index([tenantId, startDate, endDate])
  @@index([tenantId, status])
  @@index([tenantId, scope])
  @@index([tenantId, academicSessionId])
  @@map("school_holidays")
}

model WeeklyOffSetting {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  academicSessionId String?  @map("academic_session_id")
  daysOfWeek        Int[]    @default([0]) @map("days_of_week") // 0=Sunday, 6=Saturday
  isActive          Boolean  @default(true) @map("is_active")
  description       String?
  updatedByUserId   String?  @map("updated_by_user_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicSession AcademicSession? @relation(fields: [academicSessionId], references: [id], onDelete: SetNull)

  @@unique([tenantId, academicSessionId])
  @@index([tenantId, isActive])
  @@map("weekly_off_settings")
}

model HolidayAuditLog {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  holidayId     String?  @map("holiday_id")
  action        String // CREATED, UPDATED, CANCELLED, ATTENDANCE_OVERRIDE, WEEKLY_OFF_UPDATED
  previousState Json?    @map("previous_state")
  newState      Json?    @map("new_state")
  reason        String
  userId        String?  @map("user_id")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  holiday SchoolHoliday? @relation(fields: [holidayId], references: [id], onDelete: SetNull)
  user    User?          @relation("HolidayAuditor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, holidayId])
  @@index([tenantId, action])
  @@index([tenantId, createdAt])
  @@map("holiday_audit_logs")
}

// ---------------------------------------------------------
// 15. EMPLOYEE & HR ATTENDANCE MANAGEMENT (PHASE 2)
// ---------------------------------------------------------

model Employee {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  employeeNo           String    @map("employee_no")
  userId               String?   @unique @map("user_id")
  firstNameEn          String    @map("first_name_en")
  lastNameEn           String?   @map("last_name_en")
  fullNameUr           String?   @map("full_name_ur")
  gender               String    @default("MALE") // MALE, FEMALE, OTHER
  dob                  DateTime? @map("dob")
  nationalId           String?   @map("national_id") // CNIC / Passport
  phone                String?
  email                String?
  departmentId         String?   @map("department_id")
  designationId        String?   @map("designation_id")
  employeeCategoryId   String?   @map("employee_category_id")
  employmentTypeId     String?   @map("employment_type_id")
  shiftId              String?   @map("shift_id")
  joiningDate          DateTime  @default(now()) @map("joining_date")
  currentStatus        String    @default("ACTIVE") @map("current_status") // ACTIVE, ON_LEAVE, PROBATION, SUSPENDED, RESIGNED, TERMINATED, RETIRED
  standardWorkingHours Decimal?  @default(8.00) @map("standard_working_hours") @db.Decimal(4, 2)
  confirmationStatus   String    @default("CONFIRMED") @map("confirmation_status") // PROBATION, EXTENDED_PROBATION, CONFIRMED
  probationEndDate     DateTime? @map("probation_end_date")
  confirmationDate     DateTime? @map("confirmation_date")
  customFields         Json?     @map("custom_fields")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant                  Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                    User?                        @relation("UserEmployee", fields: [userId], references: [id], onDelete: SetNull)
  department              Department?                  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation             Designation?                 @relation(fields: [designationId], references: [id], onDelete: SetNull)
  employeeCategory        EmployeeCategory?            @relation(fields: [employeeCategoryId], references: [id], onDelete: SetNull)
  employmentType          EmploymentType?              @relation(fields: [employmentTypeId], references: [id], onDelete: SetNull)
  shift                   Shift?                       @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  attendanceRecords       EmployeeAttendanceRecord[]
  auditLogs               EmployeeAttendanceAuditLog[]
  shiftAssignments        EmployeeShiftAssignment[]
  scheduleAssignments     EmployeeScheduleAssignment[]
  leavePolicyAssignments  LeavePolicyAssignment[]
  leaveEntitlements       EmployeeLeaveEntitlement[]
  leaveLedgerTransactions LeaveLedgerTransaction[]
  leaveApplications       LeaveApplication[]
  leaveWorkflowRules      LeaveApprovalWorkflowRule[]
  payrollDeductionInputs  PayrollDeductionInput[]
  payrollDeductionAssignments PayrollDeductionPolicyAssignment[]

  @@unique([tenantId, employeeNo])
  @@index([tenantId, currentStatus])
  @@index([tenantId, departmentId])
  @@index([tenantId, designationId])
  @@map("employees")
}

model EmployeeAttendanceRecord {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  employeeId         String    @map("employee_id")
  attendanceDate     DateTime  @map("attendance_date") // Normalized UTC midnight
  shiftId            String    @map("shift_id")
  scheduledStartTime String?   @map("scheduled_start_time") // HH:MM
  scheduledEndTime   String?   @map("scheduled_end_time") // HH:MM
  checkInTime        DateTime? @map("check_in_time")
  checkOutTime       DateTime? @map("check_out_time")
  status             String    @default("PRESENT") // PRESENT, ABSENT, LATE, HALF_DAY, ON_LEAVE, EARLY_DEPARTURE, HOLIDAY, OFF_DAY
  lateMinutes        Int       @default(0) @map("late_minutes")
  earlyExitMinutes   Int       @default(0) @map("early_exit_minutes")
  workedMinutes      Int       @default(0) @map("worked_minutes")
  overtimeMinutes    Int       @default(0) @map("overtime_minutes")
  isHoliday          Boolean   @default(false) @map("is_holiday")
  isWeeklyOff        Boolean   @default(false) @map("is_weekly_off")
  leaveTypeId           String?   @map("leave_type_id")
  // Phase 2 leave-link fields — populated when status = ON_LEAVE
  leaveApplicationId    String?   @map("leave_application_id")
  leaveScope            String?   @map("leave_scope")            // FULL_DAY | HALF_DAY | SPECIFIC_SHIFT | HOURLY
  halfDayPeriod         String?   @map("half_day_period")        // FIRST_HALF | SECOND_HALF (for HALF_DAY scope)
  leaveStartTime        String?   @map("leave_start_time")       // HH:MM (for HOURLY scope)
  leaveEndTime          String?   @map("leave_end_time")         // HH:MM (for HOURLY scope)
  remarks               String?
  punchSource           String    @default("MANUAL") @map("punch_source") // MANUAL, BIOMETRIC, RFID, MOBILE_APP
  recordedByUserId      String?   @map("recorded_by_user_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  tenant          Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee        Employee                     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift           Shift                        @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  leaveType       LeaveType?                   @relation(fields: [leaveTypeId], references: [id], onDelete: SetNull)
  leaveApplication LeaveApplication?            @relation("AttendanceLeaveLink", fields: [leaveApplicationId], references: [id], onDelete: SetNull)
  payrollDeductionInputs PayrollDeductionInput[]
  recordedBy      User?                        @relation("EmpAttendanceRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  auditLogs       EmployeeAttendanceAuditLog[]

  @@unique([tenantId, employeeId, attendanceDate, shiftId])
  @@index([tenantId, attendanceDate])
  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@index([tenantId, shiftId])
  @@index([tenantId, leaveApplicationId])
  @@map("employee_attendance_records")
}

model EmployeeAttendanceAuditLog {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  attendanceRecordId String    @map("attendance_record_id")
  employeeId         String    @map("employee_id")
  shiftId            String?   @map("shift_id")
  attendanceDate     DateTime  @map("attendance_date")
  previousStatus     String    @map("previous_status")
  newStatus          String    @map("new_status")
  previousCheckIn    DateTime? @map("previous_check_in")
  newCheckIn         DateTime? @map("new_check_in")
  previousCheckOut   DateTime? @map("previous_check_out")
  newCheckOut        DateTime? @map("new_check_out")
  previousRemarks    String?   @map("previous_remarks")
  newRemarks         String?   @map("new_remarks")
  correctionReason   String    @map("correction_reason")
  correctedByUserId  String?   @map("corrected_by_user_id")
  createdAt          DateTime  @default(now()) @map("created_at")

  tenant           Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attendanceRecord EmployeeAttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  employee         Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift            Shift?                   @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  correctedBy      User?                    @relation("EmpAttendanceCorrector", fields: [correctedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, attendanceRecordId])
  @@index([tenantId, employeeId])
  @@index([tenantId, shiftId])
  @@index([tenantId, createdAt])
  @@map("employee_attendance_audit_logs")
}

// ---------------------------------------------------------
// 16. WORK SCHEDULE & DUTY PATTERN MANAGEMENT
// ---------------------------------------------------------

model WorkSchedule {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  name          String
  code          String
  description   String?
  isDefault     Boolean   @default(false) @map("is_default")
  isActive      Boolean   @default(true) @map("is_active")
  effectiveFrom DateTime  @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  days        WorkScheduleDay[]
  assignments EmployeeScheduleAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@index([tenantId, isDefault])
  @@map("work_schedules")
}

model WorkScheduleDay {
  id             String   @id @default(uuid())
  workScheduleId String   @map("work_schedule_id")
  dayOfWeek      Int      @map("day_of_week") // 0=Sunday, 1=Monday ... 6=Saturday
  isWorkingDay   Boolean  @default(true) @map("is_working_day")
  shiftIds       Json     @map("shift_ids") // Array of Shift UUID strings e.g. ["shift-id-1", "shift-id-2"]
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  workSchedule WorkSchedule @relation(fields: [workScheduleId], references: [id], onDelete: Cascade)

  @@unique([workScheduleId, dayOfWeek])
  @@index([workScheduleId])
  @@map("work_schedule_days")
}

model EmployeeScheduleAssignment {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  scheduleId       String    @map("schedule_id")
  assignmentType   String    @default("EMPLOYEE") @map("assignment_type") // EMPLOYEE, DEPARTMENT, DESIGNATION, EMPLOYMENT_TYPE, INSTITUTIONAL_DEFAULT
  employeeId       String?   @map("employee_id")
  departmentId     String?   @map("department_id")
  designationId    String?   @map("designation_id")
  employmentTypeId String?   @map("employment_type_id")
  isOverride       Boolean   @default(false) @map("is_override") // true for individual employee custom overrides
  effectiveFrom    DateTime  @map("effective_from") // Normalized UTC midnight
  effectiveTo      DateTime? @map("effective_to") // Normalized UTC midnight
  reason           String?
  isActive         Boolean   @default(true) @map("is_active")
  assignedByUserId String?   @map("assigned_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schedule       WorkSchedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  employee       Employee?       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department     Department?     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  designation    Designation?    @relation(fields: [designationId], references: [id], onDelete: Cascade)
  employmentType EmploymentType? @relation(fields: [employmentTypeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId, effectiveFrom])
  @@index([tenantId, departmentId, effectiveFrom])
  @@index([tenantId, designationId, effectiveFrom])
  @@index([tenantId, employmentTypeId, effectiveFrom])
  @@index([tenantId, scheduleId])
  @@index([tenantId, isActive])
  @@map("employee_schedule_assignments")
}

// ---------------------------------------------------------
// 17. LEAVE MANAGEMENT FOUNDATION (PHASE 1)
// ---------------------------------------------------------

model LeavePolicy {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  name          String
  code          String
  description   String?
  isDefault     Boolean   @default(false) @map("is_default")
  status        String    @default("ACTIVE") // ACTIVE, INACTIVE, DRAFT, ARCHIVED
  effectiveFrom DateTime  @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rules              LeavePolicyRule[]
  assignments        LeavePolicyAssignment[]
  entitlements       EmployeeLeaveEntitlement[]
  ledgerTransactions LeaveLedgerTransaction[]
  leaveApplications  LeaveApplication[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, isDefault])
  @@map("leave_policies")
}

model LeavePolicyRule {
  id                   String  @id @default(uuid())
  leavePolicyId        String  @map("leave_policy_id")
  leaveTypeId          String  @map("leave_type_id")
  annualEntitlement    Decimal @default(0.00) @map("annual_entitlement") @db.Decimal(5, 2)
  isPaid               Boolean @default(true) @map("is_paid")
  isUnlimited          Boolean @default(false) @map("is_unlimited")
  allocationMethod     String  @default("ANNUAL_UPFRONT") @map("allocation_method") // ANNUAL_UPFRONT, MONTHLY_ACCRUAL, JOINING_DATE_BASED, CONFIRMATION_BASED, PRORATED
  minLeaveUnit         Decimal @default(0.50) @map("min_leave_unit") @db.Decimal(3, 2)
  allowHalfDay         Boolean @default(true) @map("allow_half_day")
  allowShiftWise       Boolean @default(true) @map("allow_shift_wise")
  allowHourly          Boolean @default(false) @map("allow_hourly")
  allowNegativeBalance Boolean @default(false) @map("allow_negative_balance")
  maxNegativeBalance   Decimal @default(0.00) @map("max_negative_balance") @db.Decimal(5, 2)
  maxConsecutiveDays   Int?    @map("max_consecutive_days")

  // Probation & Confirmation Configuration
  probationTreatment   String   @default("ALLOWED") @map("probation_treatment") // ALLOWED, NOT_ALLOWED, LIMITED_ENTITLEMENT, UNPAID_ONLY
  probationEntitlement Decimal? @map("probation_entitlement") @db.Decimal(5, 2)
  entitlementRelease   String   @default("ON_JOINING") @map("entitlement_release") // ON_JOINING, MONTHLY_DURING_PROBATION, ON_CONFIRMATION, PRORATED_AFTER_CONFIRMATION

  // Year-End Readiness Configuration (For Future Execution)
  yearEndAction            String   @default("EXPIRE") @map("year_end_action") // EXPIRE, CARRY_FORWARD, ENCASH, MIXED
  maxCarryForwardDays      Decimal? @map("max_carry_forward_days") @db.Decimal(5, 2)
  carryForwardExpiryMonths Int?     @map("carry_forward_expiry_months")
  maxEncashableDays        Decimal? @map("max_encashable_days") @db.Decimal(5, 2)
  minBalanceForEncashment  Decimal? @map("min_balance_for_encashment") @db.Decimal(5, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  leavePolicy LeavePolicy @relation(fields: [leavePolicyId], references: [id], onDelete: Cascade)
  leaveType   LeaveType   @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([leavePolicyId, leaveTypeId])
  @@index([leavePolicyId])
  @@index([leaveTypeId])
  @@map("leave_policy_rules")
}

model LeavePolicyAssignment {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  leavePolicyId    String    @map("leave_policy_id")
  assignmentType   String    @default("EMPLOYEE") @map("assignment_type") // EMPLOYEE, DEPARTMENT, DESIGNATION, EMPLOYMENT_TYPE, INSTITUTIONAL_DEFAULT
  employeeId       String?   @map("employee_id")
  departmentId     String?   @map("department_id")
  designationId    String?   @map("designation_id")
  employmentTypeId String?   @map("employment_type_id")
  isOverride       Boolean   @default(false) @map("is_override")
  effectiveFrom    DateTime  @map("effective_from")
  effectiveTo      DateTime? @map("effective_to")
  reason           String?
  isActive         Boolean   @default(true) @map("is_active")
  assignedByUserId String?   @map("assigned_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leavePolicy    LeavePolicy     @relation(fields: [leavePolicyId], references: [id], onDelete: Cascade)
  employee       Employee?       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department     Department?     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  designation    Designation?    @relation(fields: [designationId], references: [id], onDelete: Cascade)
  employmentType EmploymentType? @relation(fields: [employmentTypeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId, effectiveFrom])
  @@index([tenantId, departmentId, effectiveFrom])
  @@index([tenantId, designationId, effectiveFrom])
  @@index([tenantId, employmentTypeId, effectiveFrom])
  @@index([tenantId, leavePolicyId])
  @@index([tenantId, isActive])
  @@map("leave_policy_assignments")
}

model EmployeeLeaveEntitlement {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  employeeId         String   @map("employee_id")
  leaveTypeId        String   @map("leave_type_id")
  leavePolicyId      String   @map("leave_policy_id")
  leaveYear          Int      @map("leave_year") // e.g. 2026
  allocationMethod   String   @default("ANNUAL_UPFRONT") @map("allocation_method")
  openingBalance     Decimal  @default(0.00) @map("opening_balance") @db.Decimal(5, 2)
  allocatedDays      Decimal  @default(0.00) @map("allocated_days") @db.Decimal(5, 2)
  carriedForwardDays Decimal  @default(0.00) @map("carried_forward_days") @db.Decimal(5, 2)
  adjustedDays       Decimal  @default(0.00) @map("adjusted_days") @db.Decimal(5, 2)
  usedDays           Decimal  @default(0.00) @map("used_days") @db.Decimal(5, 2)
  encashedDays       Decimal  @default(0.00) @map("encashed_days") @db.Decimal(5, 2)
  expiredDays        Decimal  @default(0.00) @map("expired_days") @db.Decimal(5, 2)
  availableBalance   Decimal  @default(0.00) @map("available_balance") @db.Decimal(5, 2)
  hasOverride        Boolean  @default(false) @map("has_override")
  status             String   @default("ACTIVE") // ACTIVE, CLOSED, ADJUSTED
  lastCalculatedAt   DateTime @default(now()) @map("last_calculated_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee           Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType          LeaveType                @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  leavePolicy        LeavePolicy              @relation(fields: [leavePolicyId], references: [id], onDelete: Cascade)
  ledgerTransactions LeaveLedgerTransaction[]

  @@unique([tenantId, employeeId, leaveTypeId, leaveYear])
  @@index([tenantId, leaveYear])
  @@index([tenantId, employeeId])
  @@index([tenantId, leaveTypeId])
  @@map("employee_leave_entitlements")
}

model LeaveLedgerTransaction {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  employeeId      String   @map("employee_id")
  leaveTypeId     String   @map("leave_type_id")
  leavePolicyId   String?  @map("leave_policy_id")
  entitlementId   String?  @map("entitlement_id")
  leaveYear       Int      @map("leave_year")
  transactionType String   @map("transaction_type") // OPENING_BALANCE, ANNUAL_ALLOCATION, MONTHLY_ACCRUAL, MANUAL_ADJUSTMENT_ADD, MANUAL_ADJUSTMENT_SUBTRACT, CARRY_FORWARD, LEAVE_USAGE, LEAVE_CANCELLATION, ENCASHMENT, EXPIRY, PAYROLL_ADJUSTMENT
  amount          Decimal  @map("amount") @db.Decimal(5, 2)
  balanceBefore   Decimal  @map("balance_before") @db.Decimal(5, 2)
  balanceAfter    Decimal  @map("balance_after") @db.Decimal(5, 2)
  effectiveDate   DateTime @map("effective_date")
  reason          String?
  referenceType   String?  @map("reference_type") // MANUAL_ADJUSTMENT, ANNUAL_BATCH, LEAVE_APPLICATION, PROBATION_RELEASE
  referenceId     String?  @map("reference_id")
  shiftId         String?  @map("shift_id")
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant      Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   LeaveType                 @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  leavePolicy LeavePolicy?              @relation(fields: [leavePolicyId], references: [id], onDelete: SetNull)
  entitlement EmployeeLeaveEntitlement? @relation(fields: [entitlementId], references: [id], onDelete: SetNull)

  @@index([tenantId, employeeId, leaveYear])
  @@index([tenantId, employeeId, leaveTypeId])
  @@index([tenantId, transactionType])
  @@index([tenantId, effectiveDate])
  @@map("leave_ledger_transactions")
}

model LeaveAuditLog {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  entityType    String   @map("entity_type") // LEAVE_TYPE, LEAVE_POLICY, POLICY_ASSIGNMENT, LEAVE_ENTITLEMENT, LEAVE_LEDGER
  entityId      String   @map("entity_id")
  action        String // CREATED, UPDATED, DEACTIVATED, ASSIGNED, ALLOCATED, ADJUSTED, OVERRIDE_SET
  previousState Json?    @map("previous_state")
  newState      Json?    @map("new_state")
  reason        String?
  userId        String?  @map("user_id")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, action])
  @@index([tenantId, createdAt])
  @@map("leave_audit_logs")
}

// ---------------------------------------------------------
// 18. LEAVE MANAGEMENT: APPLICATIONS & CALCULATION ENGINE (PHASE 2)
// ---------------------------------------------------------

model LeaveApplication {
  id                     String    @id @default(uuid())
  tenantId               String    @map("tenant_id")
  applicationNumber      String    @map("application_number") // e.g. LR-2026-000001
  employeeId             String    @map("employee_id")
  leaveTypeId            String    @map("leave_type_id")
  leavePolicyId          String?   @map("leave_policy_id")
  status                 String    @default("PENDING_APPROVAL") // DRAFT, SUBMITTED, PENDING_APPROVAL, APPROVED, REJECTED, SENT_BACK, CLARIFICATION_REQUIRED, CANCELLED
  leaveScope             String    @default("FULL_DAY") @map("leave_scope") // FULL_DAY, HALF_DAY, SPECIFIC_SHIFT, MULTIPLE_SHIFTS, HOURLY
  halfDayPeriod          String?   @map("half_day_period") // FIRST_HALF, SECOND_HALF
  startDate              DateTime  @map("start_date")
  endDate                DateTime  @map("end_date")
  startTime              String?   @map("start_time") // For hourly leave e.g. "09:00"
  endTime                String?   @map("end_time") // For hourly leave e.g. "11:00"
  durationHours          Decimal?  @map("duration_hours") @db.Decimal(5, 2)
  requestedDays          Decimal   @map("requested_days") @db.Decimal(5, 2)
  workingDaysCount       Int       @default(0) @map("working_days_count")
  holidaysCount          Int       @default(0) @map("holidays_count")
  isPaid                 Boolean   @default(true) @map("is_paid") // Snapshot at submission
  reason                 String
  attachmentUrl          String?   @map("attachment_url")
  attachmentName         String?   @map("attachment_name")
  attachmentSize         Int?      @map("attachment_size")
  attachmentMime         String?   @map("attachment_mime")
  requiresAttachment     Boolean   @default(false) @map("requires_attachment")
  isAttachmentProvided   Boolean   @default(false) @map("is_attachment_provided")
  employeeStatusSnapshot String?   @map("employee_status_snapshot") // PROBATION, CONFIRMED, etc.
  policySnapshotJson     Json?     @map("policy_snapshot_json")
  balanceSnapshot        Json?     @map("balance_snapshot")
  applicantUserId        String?   @map("applicant_user_id")
  submittedAt            DateTime? @map("submitted_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   LeaveType               @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  leavePolicy LeavePolicy?            @relation(fields: [leavePolicyId], references: [id], onDelete: SetNull)
  applicant   User?                   @relation(fields: [applicantUserId], references: [id], onDelete: SetNull)
  dates            LeaveApplicationDate[]
  shifts           LeaveApplicationShift[]
  approvalInstance LeaveRequestApprovalInstance?
  payrollDeductionInputs PayrollDeductionInput[]
  attendanceRecords      EmployeeAttendanceRecord[] @relation("AttendanceLeaveLink")

  @@unique([tenantId, applicationNumber])
  @@index([tenantId, employeeId, startDate, endDate])
  @@index([tenantId, status])
  @@index([tenantId, leaveTypeId])
  @@index([tenantId, createdAt])
  @@map("leave_applications")
}

model LeaveApplicationDate {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  applicationId String   @map("application_id")
  date          DateTime
  isWorkingDay  Boolean  @default(true) @map("is_working_day")
  isHoliday     Boolean  @default(false) @map("is_holiday")
  holidayName   String?  @map("holiday_name")
  leaveQuantity Decimal  @map("leave_quantity") @db.Decimal(5, 2)
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application LeaveApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, date])
  @@index([tenantId, date])
  @@map("leave_application_dates")
}

model LeaveApplicationShift {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  applicationId String   @map("application_id")
  date          DateTime
  shiftId       String   @map("shift_id")
  shiftCode     String   @map("shift_code")
  shiftName     String   @map("shift_name")
  startTime     String   @map("start_time")
  endTime       String   @map("end_time")
  leaveFraction Decimal  @default(0.50) @map("leave_fraction") @db.Decimal(5, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application LeaveApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  shift       Shift?           @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@unique([applicationId, date, shiftId])
  @@index([tenantId, date, shiftId])
  @@map("leave_application_shifts")
}

model LeaveSequence {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  year         Int
  lastSequence Int      @default(0) @map("last_sequence")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, year])
  @@map("leave_sequences")
}

// ---------------------------------------------------------
// 19. LEAVE MANAGEMENT: APPROVAL WORKFLOWS & EXECUTION (PHASE 2 STEP 2)
// ---------------------------------------------------------

model LeaveApprovalWorkflow {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  name            String
  code            String
  description     String?
  isActive        Boolean   @default(true) @map("is_active")
  isDefault       Boolean   @default(false) @map("is_default")
  effectiveFrom   DateTime  @default(now()) @map("effective_from")
  effectiveTo     DateTime? @map("effective_to")
  version         Int       @default(1)
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
