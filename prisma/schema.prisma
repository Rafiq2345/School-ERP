model Shift {
  id                    String    @id @default(uuid())
  tenantId              String    @map("tenant_id")
  name                  String
  code                  String
  startTime             String    @map("start_time") // HH:MM 24hr format (e.g. 08:00)
  endTime               String    @map("end_time") // HH:MM 24hr format (e.g. 16:00)
  graceMinutes          Int       @default(15) @map("grace_minutes") // Late arrival grace
  earlyExitGraceMinutes Int       @default(0) @map("early_exit_grace_minutes")
  breakMinutes          Int       @default(0) @map("break_minutes")
  minHoursFullDay       Decimal?  @default(6.00) @map("min_hours_full_day") @db.Decimal(4, 2)
  minHoursHalfDay       Decimal?  @default(3.50) @map("min_hours_half_day") @db.Decimal(4, 2)
  workingDays           Json?     @map("working_days") // array of weekday numbers [1,2,3,4,5,6] (1=Mon..7=Sun or 0=Sun)
  daySpecificTimings    Json?     @map("day_specific_timings") // { "5": { "startTime": "08:00", "endTime": "12:30" } }
  isDefault             Boolean   @default(false) @map("is_default")
  effectiveFrom         DateTime  @default(now()) @map("effective_from")
  effectiveTo           DateTime? @map("effective_to")
  isActive              Boolean   @default(true) @map("is_active")
  description           String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  tenant                    Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
