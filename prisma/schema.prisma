// Prisma Schema for School-ERP (Standard PostgreSQL Multi-Tenant Database)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// 1. TENANT & SCHOOL PROFILE
// ---------------------------------------------------------

model Tenant {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  status    String   @default("ACTIVE") // ACTIVE, TRIAL, SUSPENDED, DEACTIVATED
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Core Foundation Relations
  profile           SchoolProfile?
  users             User[]
  roles             Role[]
  userRoles         UserRole[]
  rolePermissions   RolePermission[]
  sessions          UserSession[]
  resetTokens       PasswordResetToken[]
  auditLogs         AuditLog[]
  publishing        PublishingWorkflow[]
  publishingBatches PublishingBatch[]
  approvalRequests  ApprovalRequest[]
  approvalSteps     ApprovalStep[]
  settings          TenantSetting[]
  featureToggles    ModuleFeatureToggle[]
  subscription      TenantSubscription?
  providerInvoices  ProviderInvoice[]
  proofSubmissions  PaymentProofSubmission[]

  // Administration Configuration Relations
  academicSessions    AcademicSession[]
  classCategories     ClassCategory[]
  schoolClasses       SchoolClass[]
  sections            Section[]
  subjects            Subject[]
  classSubjects       ClassSubject[]
  studentCategories   StudentCategory[]
  houses              House[]
  calendarEvents      AcademicCalendarEvent[]
  departments         Department[]
  designations        Designation[]
  employeeCategories  EmployeeCategory[]
  employmentTypes     EmploymentType[]
  leaveTypes          LeaveType[]
  shifts              Shift[]
  workingDayPolicies  WorkingDayPolicy[]
  gradingSchemes      GradingScheme[]
  gradeBands          GradeBand[]
  passingRules        PassingRule[]
  subjectPassingRules SubjectPassingRule[]
  examRuleAssignments ExamRuleAssignment[]
  documentSequences   DocumentSequence[]
  customFieldDefs     CustomFieldDefinition[]
  customFieldOptions  CustomFieldOption[]

  @@map("tenants")
}

model SchoolProfile {
  id             String   @id @default(uuid())
  tenantId       String   @unique @map("tenant_id")
  nameEn         String   @map("name_en")
  nameUr         String   @map("name_ur")
  code           String
  registrationNo String?  @map("registration_no")
  logoUrl        String?  @map("logo_url")
  contactEmail   String?  @map("contact_email")
  contactPhone   String?  @map("contact_phone")
  addressEn      String?  @map("address_en")
  addressUr      String?  @map("address_ur")
  currencySymbol String   @default("Rs.") @map("currency_symbol")
  currencyCode   String   @default("PKR") @map("currency_code")
  timezone       String   @default("Asia/Karachi")
  dateFormat     String   @default("DD/MM/YYYY") @map("date_format")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("school_profiles")
}

// ---------------------------------------------------------
// 2. USERS, ROLES & PERMISSIONS (10-ACTION RBAC)
// ---------------------------------------------------------

model User {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  username            String
  email               String?
  phone               String?
  passwordHash        String    @map("password_hash")
  userType            String    @map("user_type") // ADMIN, EMPLOYEE, TEACHER, STUDENT, PARENT
  status              String    @default("ACTIVE") // ACTIVE, INACTIVE, LOCKED
  preferredLocale     String    @default("en") @map("preferred_locale") // en, ur
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockoutUntil        DateTime? @map("lockout_until")
  lastLoginAt         DateTime? @map("last_login_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles   UserRole[]
  sessions    UserSession[]
  resetTokens PasswordResetToken[]

  @@unique([tenantId, username])
  @@unique([tenantId, email])
  @@index([tenantId, userType])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  code        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, code])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  module      String // CONFIG, SECURITY, ADMISSIONS, ACADEMICS, ATTENDANCE, BILLING, EXAMS, HR_PAYROLL, ACCOUNTS, LIBRARY, INVENTORY, COMMUNICATION, PUBLISHING, AUDIT
  action      String // VIEW, CREATE, EDIT, DELETE, APPROVE, PRINT, EXPORT, PUBLISH, UNPUBLISH, REVERSE
  code        String  @unique // e.g. BILLING:REVERSE, EXAMS:PUBLISH
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------
// 3. SESSIONS & SECURITY TOKENS
// ---------------------------------------------------------

model UserSession {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("user_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ---------------------------------------------------------
// 4. UNIVERSAL AUDIT LOG (POSTGRESQL JSONB)
// ---------------------------------------------------------

model AuditLog {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  userId        String?  @map("user_id")
  userRole      String?  @map("user_role")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  module        String
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  action        String // CREATE, UPDATE, DELETE, APPROVE, PRINT, EXPORT, PUBLISH, UNPUBLISH, REVERSE
  oldValues     Json?    @map("old_values")
  newValues     Json?    @map("new_values")
  changeSummary String?  @map("change_summary")
  requestId     String?  @map("request_id")
  timestamp     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, module, timestamp])
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------
// 5. CENTRAL PUBLISHING ENGINE FOUNDATION
// ---------------------------------------------------------

model PublishingWorkflow {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  entityType        String    @map("entity_type") // FEE_VOUCHER, EXAM_RESULT, RESULT_CARD, TIMETABLE, NOTICE, PAYSLIP, DOCUMENT
  entityId          String    @map("entity_id")
  currentStatus     String    @default("DRAFT") @map("current_status") // DRAFT, UNDER_REVIEW, APPROVED, PUBLISHED, UNPUBLISHED, ARCHIVED
  targetAudience    String    @default("ALL") @map("target_audience") // ALL, ADMIN, TEACHER, EMPLOYEE, STUDENT, PARENT
  version           Int       @default(1)
  createdByUserId   String    @map("created_by_user_id")
  reviewedByUserId  String?   @map("reviewed_by_user_id")
  approvedByUserId  String?   @map("approved_by_user_id")
  publishedByUserId String?   @map("published_by_user_id")
  publishedAt       DateTime? @map("published_at")
  archivedAt        DateTime? @map("archived_at")
  reasonOrNotes     String?   @map("reason_or_notes")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entityType, entityId])
  @@index([tenantId, currentStatus])
  @@map("publishing_workflows")
}

model PublishingBatch {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  batchNo           String   @unique @map("batch_no")
  entityType        String   @map("entity_type")
  actionType        String   @map("action_type") // BULK_PUBLISH, BULK_UNPUBLISH, BULK_ARCHIVE
  totalCount        Int      @map("total_count")
  successCount      Int      @default(0) @map("success_count")
  failedCount       Int      @default(0) @map("failed_count")
  initiatedByUserId String   @map("initiated_by_user_id")
  summaryJson       Json?    @map("summary_json")
  createdAt         DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("publishing_batches")
}

// ---------------------------------------------------------
// 6. APPROVAL ENGINE FOUNDATION
// ---------------------------------------------------------

model ApprovalRequest {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  module          String
  entityType      String    @map("entity_type")
  entityId        String    @map("entity_id")
  title           String
  status          String    @default("PENDING") @map("status") // PENDING, APPROVED, REJECTED, CANCELLED
  requesterUserId String    @map("requester_user_id")
  approverUserId  String?   @map("approver_user_id")
  approvedAt      DateTime? @map("approved_at")
  remarks         String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  steps  ApprovalStep[]

  @@index([tenantId, status])
  @@map("approval_requests")
}

model ApprovalStep {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  requestId        String    @map("request_id")
  stepNumber       Int       @map("step_number")
  approverRoleId   String    @map("approver_role_id")
  status           String    @default("PENDING") // PENDING, APPROVED, REJECTED
  decisionByUserId String?   @map("decision_by_user_id")
  decisionAt       DateTime? @map("decision_at")
  comments         String?

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("approval_steps")
}

// ---------------------------------------------------------
// 7. SETTINGS & FEATURE CONFIGURATION
// ---------------------------------------------------------

model TenantSetting {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  settingKey   String   @map("setting_key")
  settingValue String   @map("setting_value")
  category     String   @default("GENERAL") // GENERAL, ACADEMIC, FINANCE, SECURITY
  isEncrypted  Boolean  @default(false) @map("is_encrypted")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, settingKey])
  @@map("tenant_settings")
}

model ModuleFeatureToggle {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  moduleCode      String   @map("module_code")
  isEnabled       Boolean  @default(true) @map("is_enabled")
  configOverrides Json?    @map("config_overrides")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleCode])
  @@map("module_feature_toggles")
}

// ---------------------------------------------------------
// 7.1 PLATFORM SUBSCRIPTION, LICENSING & INVOICING (PROVIDER -> SCHOOL)
// ---------------------------------------------------------

model TenantSubscription {
  id                 String    @id @default(uuid())
  tenantId           String    @unique @map("tenant_id")
  planName           String    @default("BASE") @map("plan_name") // BASE, STANDARD, FULL, ENTERPRISE
  billingCycle       String    @default("MONTHLY") @map("billing_cycle") // MONTHLY, QUARTERLY, ANNUAL
  baseFee            Decimal   @default(15000.00) @map("base_fee") @db.Decimal(10, 2)
  currency           String    @default("PKR")
  status             String    @default("ACTIVE") // ACTIVE, PAYMENT_DUE, GRACE_PERIOD, SUSPENDED, MANUALLY_ACTIVATED, EXEMPT
  currentPeriodStart DateTime  @default(now()) @map("current_period_start")
  currentPeriodEnd   DateTime  @map("current_period_end")
  gracePeriodDays    Int       @default(7) @map("grace_period_days")
  showHistoryToSchool Boolean  @default(true) @map("show_history_to_school")
  suspendedAt        DateTime? @map("suspended_at")
  lastPaymentDate    DateTime? @map("last_payment_date")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices ProviderInvoice[]

  @@map("tenant_subscriptions")
}

model ProviderInvoice {
  id              String    @id @default(uuid())
  invoiceNo       String    @unique @map("invoice_no") // e.g. INV-2026-0001
  tenantId        String    @map("tenant_id")
  subscriptionId  String?   @map("subscription_id")
  billingPeriod   String    @map("billing_period") // e.g. "August 2026"
  issueDate       DateTime  @default(now()) @map("issue_date")
  dueDate         DateTime  @map("due_date")
  graceUntil      DateTime? @map("grace_until")
  amount          Decimal   @map("amount") @db.Decimal(10, 2)
  taxAmount       Decimal   @default(0.00) @map("tax_amount") @db.Decimal(10, 2)
  discountAmount  Decimal   @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  previousBalance Decimal   @default(0.00) @map("previous_balance") @db.Decimal(10, 2)
  totalPayable    Decimal   @map("total_payable") @db.Decimal(10, 2)
  paidAmount      Decimal   @default(0.00) @map("paid_amount") @db.Decimal(10, 2)
  status          String    @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID, OVERDUE, WAIVED, CANCELLED
  providerNotes   String?   @map("provider_notes") // Internal provider notes (HIDDEN from school)
  schoolNotes     String?   @map("school_notes") // Notes visible to school
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription TenantSubscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  proofs       PaymentProofSubmission[]

  @@map("provider_invoices")
}

model PaymentProofSubmission {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  invoiceId           String    @map("invoice_id")
  documentUrl         String    @map("document_url") // Receipt screenshot / base64 / storage URL
  submittedAmount     Decimal   @map("submitted_amount") @db.Decimal(10, 2)
  paymentDate         DateTime  @default(now()) @map("payment_date")
  transactionRef      String    @map("transaction_ref") // UTR / Reference number
  bankName            String?   @map("bank_name") // Sender bank or payment channel (e.g. Meezan, Raast, JazzCash)
  notes               String?   @map("notes")
  submittedByUserId   String    @map("submitted_by_user_id")
  verificationStatus  String    @default("PENDING") // PENDING, AI_MATCH, AI_MISMATCH, NEEDS_MANUAL_REVIEW, VERIFIED, REJECTED
  aiConfidenceScore   Decimal?  @map("ai_confidence_score") @db.Decimal(4, 2)
  aiExtractedDataJson Json?     @map("ai_extracted_data_json") // Extracted: { amount, ref, date, sender, receiver }
  verifiedByUserId    String?   @map("verified_by_user_id")
  verifiedAt          DateTime? @map("verified_at")
  rejectionReason     String?   @map("rejection_reason")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice ProviderInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payment_proof_submissions")
}

model ProviderReceivingAccount {
  id            String   @id @default(uuid())
  bankName      String   @map("bank_name") // e.g. "Meezan Bank Ltd"
  accountTitle  String   @map("account_title") // e.g. "EduERP Technologies (Pvt) Ltd"
  accountNumber String   @map("account_number") // e.g. "0101-0105678901"
  iban          String?  @map("iban") // e.g. "PK36MEZN0001010105678901"
  raastId       String?  @map("raast_id") // e.g. "billing@eduerp.pk"
  instructions  String?  @map("instructions") // "Please mention Invoice # in payment reference"
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("provider_receiving_accounts")
}

// ---------------------------------------------------------
// 8. ADMINISTRATION CONFIGURATION: ACADEMIC STRUCTURE MASTER
// ---------------------------------------------------------

model AcademicSession {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  name            String
  code            String
  startDate       DateTime  @map("start_date")
  endDate         DateTime  @map("end_date")
  isCurrent       Boolean   @default(false) @map("is_current")
  status          String    @default("DRAFT") // DRAFT, ACTIVE, CLOSED, LOCKED
  lockedAt        DateTime? @map("locked_at")
  closedAt        DateTime? @map("closed_at")
  createdByUserId String?   @map("created_by_user_id")
  updatedByUserId String?   @map("updated_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant              Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classSubjects       ClassSubject[]
  calendarEvents      AcademicCalendarEvent[]
  subjectPassingRules SubjectPassingRule[]
  examRuleAssignments ExamRuleAssignment[]
  documentSequences   DocumentSequence[]

  @@unique([tenantId, code])
  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, isCurrent])
  @@map("academic_sessions")
}

model ClassCategory {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  code        String
  sortOrder   Int      @default(0) @map("sort_order")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classes SchoolClass[]

  @@unique([tenantId, code])
  @@index([tenantId, sortOrder])
  @@map("class_categories")
}

model SchoolClass {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  classCategoryId String?  @map("class_category_id")
  name            String
  code            String
  sortOrder       Int      @default(0) @map("sort_order")
  description     String?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classCategory       ClassCategory?       @relation(fields: [classCategoryId], references: [id], onDelete: SetNull)
  sections            Section[]
  classSubjects       ClassSubject[]
  subjectPassingRules SubjectPassingRule[]
  examRuleAssignments ExamRuleAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId, sortOrder])
  @@map("school_classes")
}

model Section {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  classId   String   @map("class_id")
  name      String
  code      String
  capacity  Int?
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([tenantId, classId, code])
  @@index([tenantId, classId])
  @@map("sections")
}

model Subject {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  code        String
  shortName   String?  @map("short_name")
  subjectType String   @default("THEORY") @map("subject_type") // THEORY, PRACTICAL, BOTH, ACTIVITY
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classSubjects       ClassSubject[]
  subjectPassingRules SubjectPassingRule[]

  @@unique([tenantId, code])
  @@index([tenantId, sortOrder])
  @@map("subjects")
}

model ClassSubject {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  academicSessionId String   @map("academic_session_id")
  classId           String   @map("class_id")
  subjectId         String   @map("subject_id")
  isCompulsory      Boolean  @default(true) @map("is_compulsory")
  sortOrder         Int      @default(0) @map("sort_order")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  schoolClass     SchoolClass     @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject         Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([tenantId, academicSessionId, classId, subjectId])
  @@index([tenantId, classId])
  @@map("class_subjects")
}

model StudentCategory {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  code        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("student_categories")
}

model House {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  code        String
  color       String?
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("houses")
}

model AcademicCalendarEvent {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  academicSessionId String?  @map("academic_session_id")
  title             String
  eventType         String   @default("EVENT") @map("event_type") // HOLIDAY, EXAM_PERIOD, SPORTS, MEETING, ACTIVITY, EVENT
  isHoliday         Boolean  @default(false) @map("is_holiday")
  startDate         DateTime @map("start_date")
  endDate           DateTime @map("end_date")
  applicableTo      String   @default("ALL") @map("applicable_to") // ALL, STUDENTS, TEACHERS, EMPLOYEES
  description       String?
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicSession AcademicSession? @relation(fields: [academicSessionId], references: [id], onDelete: SetNull)

  @@index([tenantId, academicSessionId, startDate])
  @@index([tenantId, isHoliday])
  @@map("academic_calendar_events")
}

// ---------------------------------------------------------
// 9. ADMINISTRATION CONFIGURATION: HR MASTER
// ---------------------------------------------------------

model Department {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  code        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  designations Designation[]

  @@unique([tenantId, code])
  @@map("departments")
}

model Designation {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  departmentId String?  @map("department_id")
  name         String
  code         String
  description  String?
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([tenantId, code])
  @@index([tenantId, departmentId])
  @@map("designations")
}

model EmployeeCategory {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  code        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("employee_categories")
}

model EmploymentType {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  code        String
  salaryBasis String?  @map("salary_basis") // MONTHLY, HOURLY, DAILY, CONTRACT
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("employment_types")
}

model LeaveType {
  id                  String   @id @default(uuid())
  tenantId            String   @map("tenant_id")
  name                String
  code                String
  isPaid              Boolean  @default(true) @map("is_paid")
  annualLimit         Int?     @map("annual_limit")
  carryForwardAllowed Boolean  @default(false) @map("carry_forward_allowed")
  carryForwardLimit   Int?     @map("carry_forward_limit")
  requiresApproval    Boolean  @default(true) @map("requires_approval")
  description         String?
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("leave_types")
}

model Shift {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String
  code         String
  startTime    String   @map("start_time") // HH:MM 24hr format
  endTime      String   @map("end_time") // HH:MM 24hr format
  graceMinutes Int      @default(15) @map("grace_minutes")
  breakMinutes Int      @default(30) @map("break_minutes")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("shifts")
}

model WorkingDayPolicy {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  name           String
  code           String
  applicableDays Json      @map("applicable_days") // Array of weekday ints e.g. [1, 2, 3, 4, 5]
  effectiveFrom  DateTime  @map("effective_from")
  effectiveTo    DateTime? @map("effective_to")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("working_day_policies")
}

// ---------------------------------------------------------
// 10. ADMINISTRATION CONFIGURATION: EXAM RULE MASTER
// ---------------------------------------------------------

model GradingScheme {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  name            String
  code            String
  calculationMode String   @default("PERCENTAGE") @map("calculation_mode") // PERCENTAGE, GRADE, GPA, GRADE_AND_GPA
  description     String?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gradeBands          GradeBand[]
  examRuleAssignments ExamRuleAssignment[]

  @@unique([tenantId, code])
  @@map("grading_schemes")
}

model GradeBand {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  gradingSchemeId String   @map("grading_scheme_id")
  minValue        Decimal  @map("min_value") @db.Decimal(5, 2)
  maxValue        Decimal  @map("max_value") @db.Decimal(5, 2)
  gradeLabel      String?  @map("grade_label")
  gpaValue        Decimal? @map("gpa_value") @db.Decimal(3, 2)
  remarks         String?
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gradingScheme GradingScheme @relation(fields: [gradingSchemeId], references: [id], onDelete: Cascade)

  @@index([tenantId, gradingSchemeId])
  @@map("grade_bands")
}

model PassingRule {
  id                       String   @id @default(uuid())
  tenantId                 String   @map("tenant_id")
  name                     String
  code                     String
  minOverallPercentage     Decimal? @map("min_overall_percentage") @db.Decimal(5, 2)
  maxFailedSubjects        Int?     @default(0) @map("max_failed_subjects")
  percentageRuleEnabled    Boolean  @default(true) @map("percentage_rule_enabled")
  failedSubjectRuleEnabled Boolean  @default(true) @map("failed_subject_rule_enabled")
  theoryPracticalStrategy  String   @default("SEPARATE") @map("theory_practical_strategy") // SEPARATE, COMBINED, THEORY_ONLY
  configJson               Json?    @map("config_json")
  isActive                 Boolean  @default(true) @map("is_active")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subjectPassingRules SubjectPassingRule[]
  examRuleAssignments ExamRuleAssignment[]

  @@unique([tenantId, code])
  @@map("passing_rules")
}

model SubjectPassingRule {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  passingRuleId      String   @map("passing_rule_id")
  academicSessionId  String?  @map("academic_session_id")
  classId            String   @map("class_id")
  subjectId          String   @map("subject_id")
  totalPassMarks     Decimal? @map("total_pass_marks") @db.Decimal(6, 2)
  theoryPassMarks    Decimal? @map("theory_pass_marks") @db.Decimal(6, 2)
  practicalPassMarks Decimal? @map("practical_pass_marks") @db.Decimal(6, 2)
  passLogic          String   @default("SEPARATE") @map("pass_logic") // SEPARATE, COMBINED
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  passingRule     PassingRule      @relation(fields: [passingRuleId], references: [id], onDelete: Cascade)
  academicSession AcademicSession? @relation(fields: [academicSessionId], references: [id], onDelete: SetNull)
  schoolClass     SchoolClass      @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject         Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([tenantId, passingRuleId, classId, subjectId])
  @@map("subject_passing_rules")
}

model ExamRuleAssignment {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  academicSessionId String   @map("academic_session_id")
  classId           String   @map("class_id")
  gradingSchemeId   String   @map("grading_scheme_id")
  passingRuleId     String   @map("passing_rule_id")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  schoolClass     SchoolClass     @relation(fields: [classId], references: [id], onDelete: Cascade)
  gradingScheme   GradingScheme   @relation(fields: [gradingSchemeId], references: [id], onDelete: Cascade)
  passingRule     PassingRule     @relation(fields: [passingRuleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, academicSessionId, classId])
  @@map("exam_rule_assignments")
}

// ---------------------------------------------------------
// 11. ADMINISTRATION CONFIGURATION: SYSTEM MASTER
// ---------------------------------------------------------

model DocumentSequence {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  moduleCode        String   @map("module_code") // ADMISSIONS, STUDENTS, BILLING, HR_PAYROLL, ACCOUNTS
  documentType      String   @map("document_type") // ADMISSION_NO, STUDENT_ID, FEE_VOUCHER, RECEIPT, EMPLOYEE_NO
  prefix            String?
  suffix            String?
  startingNumber    Int      @default(1) @map("starting_number")
  currentNumber     Int      @default(0) @map("current_number")
  paddingLength     Int      @default(5) @map("padding_length")
  resetPolicy       String   @default("NEVER") @map("reset_policy") // NEVER, ANNUAL_SESSION, FISCAL_YEAR, MONTHLY
  academicSessionId String?  @map("academic_session_id")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicSession AcademicSession? @relation(fields: [academicSessionId], references: [id], onDelete: SetNull)

  @@unique([tenantId, moduleCode, documentType, academicSessionId])
  @@index([tenantId, moduleCode, documentType])
  @@map("document_sequences")
}

model CustomFieldDefinition {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  entityType      String   @map("entity_type") // STUDENT, EMPLOYEE, ADMISSION, GUARDIAN
  fieldKey        String   @map("field_key")
  label           String
  fieldType       String   @map("field_type") // TEXT, NUMBER, DATE, DROPDOWN, MULTISELECT, CHECKBOX, RADIO, FILE, IMAGE, TEXTAREA
  isRequired      Boolean  @default(false) @map("is_required")
  sortOrder       Int      @default(0) @map("sort_order")
  validationRules Json?    @map("validation_rules")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  options CustomFieldOption[]

  @@unique([tenantId, entityType, fieldKey])
  @@map("custom_field_definitions")
}

model CustomFieldOption {
  id                      String   @id @default(uuid())
  tenantId                String   @map("tenant_id")
  customFieldDefinitionId String   @map("custom_field_definition_id")
  label                   String
  value                   String
  sortOrder               Int      @default(0) @map("sort_order")
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customFieldDefinition CustomFieldDefinition @relation(fields: [customFieldDefinitionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, customFieldDefinitionId, value])
  @@map("custom_field_options")
}
