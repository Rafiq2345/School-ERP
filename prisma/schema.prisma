  @@index([tenantId, isDefault])
  @@map("leave_approval_workflows")
}

model LeaveApprovalWorkflowRule {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  workflowId       String    @map("workflow_id")
  assignmentType   String    @default("EMPLOYEE") @map("assignment_type") // INDIVIDUAL_OVERRIDE, EMPLOYEE, DEPARTMENT, DESIGNATION, EMPLOYMENT_TYPE, LEAVE_TYPE, INSTITUTIONAL_DEFAULT
  employeeId       String?   @map("employee_id")
  departmentId     String?   @map("department_id")
  designationId    String?   @map("designation_id")
  employmentTypeId String?   @map("employment_type_id")
  leaveTypeId      String?   @map("leave_type_id")
  isOverride       Boolean   @default(false) @map("is_override")
  priority         Int       @default(100)
  effectiveFrom    DateTime  @default(now()) @map("effective_from")
  effectiveTo      DateTime? @map("effective_to")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow       LeaveApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  employee       Employee?             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department     Department?           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  designation    Designation?          @relation(fields: [designationId], references: [id], onDelete: Cascade)
  employmentType EmploymentType?       @relation(fields: [employmentTypeId], references: [id], onDelete: Cascade)
  leaveType      LeaveType?            @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([tenantId, workflowId])
  @@index([tenantId, employeeId])
  @@index([tenantId, departmentId])
  @@index([tenantId, designationId])
  @@index([tenantId, employmentTypeId])
  @@index([tenantId, leaveTypeId])
  @@index([tenantId, assignmentType])
  @@map("leave_approval_workflow_rules")
}

model LeaveApprovalWorkflowStep {
  id                    String   @id @default(uuid())
  tenantId              String   @map("tenant_id")
  workflowId            String   @map("workflow_id")
  stepNumber            Int      @map("step_number")
  stepName              String   @map("step_name")
  approverType          String   @default("ROLE") @map("approver_type") // USER, ROLE, DEPARTMENT_HEAD, DESIGNATION, MANAGEMENT
  approverUserId        String?  @map("approver_user_id")
  approverRole          String?  @map("approver_role") // SUPER_ADMIN, PRINCIPAL, HR_MANAGER, ACCOUNTS_MANAGER, etc.
  approverDesignationId String?  @map("approver_designation_id")
  isRequired            Boolean  @default(true) @map("is_required")
  autoApproveAfterDays  Int?     @map("auto_approve_after_days")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow            LeaveApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  approverUser        User?                 @relation("WorkflowStepApprover", fields: [approverUserId], references: [id], onDelete: SetNull)
  approverDesignation Designation?          @relation(fields: [approverDesignationId], references: [id], onDelete: SetNull)

  @@unique([workflowId, stepNumber])
  @@index([tenantId, workflowId])
  @@index([tenantId, approverRole])
  @@index([tenantId, approverUserId])
  @@map("leave_approval_workflow_steps")
}

model LeaveRequestApprovalInstance {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  applicationId      String    @unique @map("application_id")
  workflowId         String?   @map("workflow_id")
  workflowName       String    @map("workflow_name")
  workflowCode       String    @map("workflow_code")
  workflowSnapshot   Json      @map("workflow_snapshot")
  currentStepNumber  Int       @default(1) @map("current_step_number")
  totalSteps         Int       @default(1) @map("total_steps")
  status             String    @default("IN_PROGRESS") // IN_PROGRESS, APPROVED, REJECTED, SENT_BACK, CLARIFICATION_REQUIRED, CANCELLED
  completedAt        DateTime? @map("completed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant        Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application   LeaveApplication             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  workflow      LeaveApprovalWorkflow?       @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  steps         LeaveRequestApprovalStep[]
  actionHistory LeaveApprovalActionHistory[]

  @@index([tenantId, status])
  @@index([tenantId, currentStepNumber])
  @@index([tenantId, createdAt])
  @@map("leave_request_approval_instances")
}

model LeaveRequestApprovalStep {
  id                    String    @id @default(uuid())
  tenantId              String    @map("tenant_id")
  instanceId            String    @map("instance_id")
  stepNumber            Int       @map("step_number")
  stepName              String    @map("step_name")
  approverType          String    @map("approver_type")
  approverUserId        String?   @map("approver_user_id")
  approverRole          String?   @map("approver_role")
  approverDesignationId String?   @map("approver_designation_id")
  isRequired            Boolean   @default(true) @map("is_required")
  status                String    @default("WAITING") // WAITING, PENDING, APPROVED, REJECTED, SENT_BACK, CLARIFICATION_REQUESTED, SKIPPED
  assignedAt            DateTime? @map("assigned_at")
  actionAt              DateTime? @map("action_at")
  actionByUserId        String?   @map("action_by_user_id")
  action                String? // APPROVE, REJECT, SEND_BACK, REQUEST_CLARIFICATION, SKIP
  remarks               String?
  clarificationDetails  Json?     @map("clarification_details")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  tenant       Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instance     LeaveRequestApprovalInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  actionByUser User?                        @relation("StepActionUser", fields: [actionByUserId], references: [id], onDelete: SetNull)

  @@unique([instanceId, stepNumber])
  @@index([tenantId, status])
  @@index([tenantId, approverRole])
  @@index([tenantId, approverUserId])
  @@map("leave_request_approval_steps")
}

model LeaveApprovalActionHistory {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  instanceId     String   @map("instance_id")
  stepId         String?  @map("step_id")
  stepNumber     Int      @map("step_number")
  stepName       String   @map("step_name")
  action         String // INITIATED, APPROVED, REJECTED, SENT_BACK, CLARIFICATION_REQUESTED, CLARIFICATION_RESPONDED, SKIPPED, FINAL_APPROVED
  actorUserId    String?  @map("actor_user_id")
  actorName      String?  @map("actor_name")
  actorRole      String?  @map("actor_role")
  previousStatus String   @map("previous_status")
  newStatus      String   @map("new_status")
  remarks        String?
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  tenant   Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instance LeaveRequestApprovalInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  actor    User?                        @relation("LeaveActionActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, instanceId])
  @@index([tenantId, createdAt])
  @@map("leave_approval_action_histories")
}

// =============================================================
// 16. PAYROLL DEDUCTION FOUNDATION & RULE ENGINE (PHASE 3)
// =============================================================

/// Configurable institutional & departmental deduction rules.
/// Scope: UNPAID_LEAVE, LATE_ARRIVALS, EARLY_DEPARTURE, SHORT_HOURS, HALF_DAY, CUSTOM.
model PayrollDeductionPolicy {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  policyCode       String    @map("policy_code") // e.g. "RULE_UNPAID_CALENDAR_DEFAULT"
  policyName       String    @map("policy_name") // e.g. "Default Unpaid Leave Calendar Deduction"
  scope            String    @default("UNPAID_LEAVE") @map("scope") // UNPAID_LEAVE | LATE_ARRIVALS | etc.

  // Optional link to specific LeaveType (null = applies to all unpaid leaves)
  leaveTypeId      String?   @map("leave_type_id")

  // Calculation basis: CALENDAR_DAYS (1/30th), WORKING_DAYS, FIXED_DIVISOR
  calculationBasis String    @default("CALENDAR_DAYS") @map("calculation_basis")
  fixedDivisor     Decimal?  @map("fixed_divisor") @db.Decimal(6, 2) // Used when calculationBasis = FIXED_DIVISOR

  // For LATE_ARRIVALS scope: number of late arrivals that triggers 1 absence deduction
  lateTriggerCount Int?      @map("late_trigger_count")
  lateGraceMinutes Int       @default(15) @map("late_grace_minutes")
  lateDeductionUnit Decimal  @default(1.00) @map("late_deduction_unit") @db.Decimal(5, 2)

  // Absence deduction units
  absenceDeductionUnit Decimal @default(1.00) @map("absence_deduction_unit") @db.Decimal(5, 2)
  halfDayDeductionUnit Decimal @default(0.50) @map("half_day_deduction_unit") @db.Decimal(5, 2)

  // Early exit penalties
  earlyExitGraceMinutes Int    @default(15) @map("early_exit_grace_minutes")
  earlyExitDeductionUnit Decimal @default(0.25) @map("early_exit_deduction_unit") @db.Decimal(5, 2)

  isDefault        Boolean   @default(false) @map("is_default")

  // Caps & guards
  maxDeductionDaysPerPeriod Decimal? @map("max_deduction_days_per_period") @db.Decimal(5, 2)

  notes            String?
  isActive         Boolean   @default(true) @map("is_active")
  effectiveFrom    DateTime  @default(now()) @map("effective_from")
  effectiveTo      DateTime? @map("effective_to")

  createdByUserId  String?   @map("created_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaveType       LeaveType?       @relation(fields: [leaveTypeId], references: [id], onDelete: SetNull)
  createdBy       User?            @relation("DeductionPolicyCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  deductionInputs PayrollDeductionInput[]
  assignments     PayrollDeductionPolicyAssignment[]

  @@unique([tenantId, policyCode, leaveTypeId])
  @@index([tenantId, scope])
  @@index([tenantId, isActive])
  @@index([tenantId, leaveTypeId])
  @@map("payroll_deduction_policies")
}

/// Targeted policy assignments across 6-level hierarchy (Priority: Override 1000 > Employee 500 > Dept 300 > Designation 200 > Type 100 > Default 0)
model PayrollDeductionPolicyAssignment {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  policyId           String    @map("policy_id")

  assignmentType     String    @default("EMPLOYEE") @map("assignment_type") // INDIVIDUAL_OVERRIDE | EMPLOYEE | DEPARTMENT | DESIGNATION | EMPLOYMENT_TYPE | EMPLOYEE_CATEGORY | INSTITUTIONAL_DEFAULT
  employeeId         String?   @map("employee_id")
  departmentId       String?   @map("department_id")
  designationId      String?   @map("designation_id")
  employmentTypeId   String?   @map("employment_type_id")
  employeeCategoryId String?   @map("employee_category_id")

  isOverride         Boolean   @default(false) @map("is_override")
  priority           Int       @default(100) @map("priority")

  effectiveFrom      DateTime  @default(now()) @map("effective_from")
  effectiveTo        DateTime? @map("effective_to")
  isActive           Boolean   @default(true) @map("is_active")

  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policy           PayrollDeductionPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  employee         Employee?              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department       Department?            @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  designation      Designation?           @relation(fields: [designationId], references: [id], onDelete: Cascade)
  employmentType   EmploymentType?        @relation(fields: [employmentTypeId], references: [id], onDelete: Cascade)
  employeeCategory EmployeeCategory?      @relation(fields: [employeeCategoryId], references: [id], onDelete: Cascade)

  @@index([tenantId, policyId])
  @@index([tenantId, employeeId])
  @@index([tenantId, departmentId])
  @@index([tenantId, designationId])
  @@index([tenantId, assignmentType])
  @@map("payroll_deduction_policy_assignments")
}

/// One auditable financial evidence record per approved leave application or attendance exception
/// per payroll period. Never hard-deleted — only REVERSED, CANCELLED, or SUPERSEDED.
model PayrollDeductionInput {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")

  policyId            String    @map("policy_id")
  sourceType          String    @default("LEAVE_APPLICATION") @map("source_type") // LEAVE_APPLICATION | ATTENDANCE_ABSENCE | ATTENDANCE_LATE_ACCUMULATION | ATTENDANCE_HALF_DAY | etc.
  leaveApplicationId  String?   @map("leave_application_id")
  attendanceRecordId  String?   @map("attendance_record_id")
  attendanceDate      DateTime? @map("attendance_date")
  shiftId             String?   @map("shift_id")
  deductionSourceKey  String?   @map("deduction_source_key")

  employeeId          String    @map("employee_id")
  leaveTypeId         String?   @map("leave_type_id")

  /// Payroll period this deduction belongs to (calendar-month derived)
  payrollPeriodStart  DateTime  @map("payroll_period_start")
  payrollPeriodEnd    DateTime  @map("payroll_period_end")
  payrollPeriodLabel  String    @map("payroll_period_label") // e.g. "September 2026"

  deductionScope      String    @map("deduction_scope") // UNPAID_LEAVE | LATE_ARRIVALS | etc.
  calculationBasis    String    @map("calculation_basis") // Snapshot of policy basis at generation time

  deductionDays       Decimal   @map("deduction_days") @db.Decimal(5, 2) // Quantity (e.g. 0.5, 1.0)
  fixedDivisorUsed    Decimal?  @map("fixed_divisor_used") @db.Decimal(6, 2) // Snapshot of divisor used

  /// Amount is null until the future Payroll module processes it.
  /// We NEVER silently alter base salary — amount is populated externally.
  deductionAmount     Decimal?  @map("deduction_amount") @db.Decimal(12, 2)
  currencyCode        String    @default("PKR") @map("currency_code")

  status              String    @default("PENDING") @map("status") // PENDING | PROCESSED | REVERSED | CANCELLED | SUPERSEDED

  reversalReason      String?   @map("reversal_reason")
  reversedAt          DateTime? @map("reversed_at")
  reversedByUserId    String?   @map("reversed_by_user_id")

  systemActorNote     String?   @map("system_actor_note") // e.g. "Attendance: Unexcused Absence on 2026-09-15"

  /// JSON evidence: balance snapshots, divisor, period days, policy snapshot
  calculationEvidence Json      @map("calculation_evidence")

  createdByUserId     String?   @map("created_by_user_id")
  processedAt         DateTime? @map("processed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policy           PayrollDeductionPolicy  @relation(fields: [policyId], references: [id], onDelete: Restrict)
  leaveApplication LeaveApplication?       @relation(fields: [leaveApplicationId], references: [id], onDelete: Cascade)
  attendanceRecord EmployeeAttendanceRecord? @relation(fields: [attendanceRecordId], references: [id], onDelete: SetNull)
  shift            Shift?                  @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  employee         Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType        LeaveType?              @relation(fields: [leaveTypeId], references: [id], onDelete: SetNull)
  createdBy        User?                   @relation("DeductionInputCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reversedBy       User?                   @relation("DeductionInputReverser", fields: [reversedByUserId], references: [id], onDelete: SetNull)
  auditLogs        PayrollDeductionAuditLog[]

  @@unique([tenantId, deductionSourceKey, payrollPeriodStart])
  @@index([tenantId, leaveApplicationId, payrollPeriodStart])
  @@index([tenantId, attendanceRecordId])
  @@index([tenantId, sourceType])
  @@index([tenantId, employeeId, payrollPeriodStart])
  @@index([tenantId, status])
  @@index([tenantId, policyId])
  @@map("payroll_deduction_inputs")
}

/// Immutable append-only audit trail for every state change on PayrollDeductionInput.
model PayrollDeductionAuditLog {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  deductionInputId String   @map("deduction_input_id")

  action           String   // GENERATED | REVERSED | CANCELLED | PROCESSED | REACTIVATED | SUPERSEDED | SKIPPED
  actorUserId      String?  @map("actor_user_id")
  actorName        String?  @map("actor_name")
  previousStatus   String   @map("previous_status")
  newStatus        String   @map("new_status")
  reason           String?
  evidence         Json?    // JSON snapshot at time of action

  createdAt        DateTime @default(now()) @map("created_at")

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deductionInput PayrollDeductionInput @relation(fields: [deductionInputId], references: [id], onDelete: Cascade)
  actor         User?                 @relation("DeductionAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, deductionInputId])
  @@index([tenantId, createdAt])
  @@map("payroll_deduction_audit_logs")
}
